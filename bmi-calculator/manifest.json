{
  "manifest_version": 3,
  "name": "BMI Calculator — India",
  "version": "1.0.0",
  "description": "Calculate BMI and Ponderal Index with WHO Asian-Pacific weight categories. Metric or imperial. Runs fully in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open BMI Calculator"
  }
}
